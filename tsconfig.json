{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "n8n-workflow": ["./n8n-types.ts"]
    }
  },
  "include": ["credentials/**/*", "nodes/**/*", "index.ts", "n8n-types.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
